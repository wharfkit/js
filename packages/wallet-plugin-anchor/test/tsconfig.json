{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "isolatedModules": false,
        "resolveJsonModule": true,
        "module": "nodenext",
        "target": "es2022",
        "types": [
            "mocha",
            "node"
        ],
        "baseUrl": "..",
        "paths": {
            "$lib": [
                "src"
            ],
            "$lib/*": [
                "src/*"
            ],
            "$test": [
                "test"
            ],
            "$test/*": [
                "test/*"
            ]
        },
        "moduleResolution": "nodenext",
        "useDefineForClassFields": false
    },
    "include": [
        "*.ts",
        "**/*.ts",
        "../src/**/*.ts"
    ]
}
