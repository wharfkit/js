{
    "name": "@wharfkit/web-ui",
    "version": "0.1.2",
    "description": "Modern embedded UI renderer for WharfKit SessionKit",
    "type": "module",
    "license": "BSD-3-Clause",
    "main": "lib/web-ui.cjs",
    "module": "lib/web-ui.m.js",
    "types": "lib/web-ui.d.ts",
    "exports": {
        ".": {
            "types": "./lib/web-ui.d.ts",
            "import": "./lib/web-ui.m.js",
            "require": "./lib/web-ui.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib/*",
        "src/*"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "make check",
        "format": "biome check --write . && prettier --write \"**/*.svelte\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wharfkit/web-ui.git"
    },
    "authors": [
        "Aaron Cox <aaron@greymass.com>"
    ],
    "peerDependencies": {
        "@wharfkit/common": "^1.5.0",
        "@wharfkit/session": "^1.8.0-rc1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@wharfkit/common": "^1.5.0",
        "@wharfkit/session": "^1.8.0-rc1",
        "@wharfkit/wallet-plugin-anchor": "^1.6.1",
        "@wharfkit/wallet-plugin-cloudwallet": "^1.6.2",
        "@wharfkit/wallet-plugin-metamask": "^1.2.1",
        "@wharfkit/wallet-plugin-privatekey": "^1.1.0",
        "@wharfkit/wallet-plugin-web-authenticator": "^0.5.2",
        "@wuchale/svelte": "0.19.1",
        "@wuchale/vite-plugin": "0.17.1",
        "ajv": "^8.18.0",
        "prettier": "^3.0.0",
        "prettier-plugin-svelte": "^3.0.0",
        "svelte": "^5.53.0",
        "typescript": "^5.7.0",
        "vite": "^7.3.0",
        "vite-plugin-dts": "^4.0.0",
        "vitest": "^3.0.0",
        "wuchale": "0.21.2"
    },
    "dependencies": {},
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
