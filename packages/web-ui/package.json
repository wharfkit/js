        "ajv": "^8.18.0",
        "prettier": "^3.0.0",
        "prettier-plugin-svelte": "^3.0.0",
        "svelte": "^5.53.0",
        "typescript": "^5.7.0",
        "vite": "^7.3.0",
        "vite-plugin-dts": "^4.0.0",
        "vitest": "^3.0.0",
        "wuchale": "0.21.2"
