{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": false,
        "lib": ["esnext", "dom"],
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "$lib": ["src/lib"],
            "$ui": ["src/ui/*"]
        }
    },
    "include": ["src/*", "src/lib/*", "src/lib/**/*"]
}
