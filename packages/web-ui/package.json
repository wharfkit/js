        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@wharfkit/antelope": "workspace:*",
        "@wharfkit/common": "workspace:*",
        "@wharfkit/session": "workspace:*",
        "@wharfkit/transact-plugin-resource-provider": "workspace:*",
        "@wharfkit/wallet-plugin-anchor": "workspace:*",
        "@wharfkit/wallet-plugin-cloudwallet": "workspace:*",
        "@wharfkit/wallet-plugin-metamask": "workspace:*",
        "@wharfkit/wallet-plugin-privatekey": "workspace:*",
        "@wharfkit/wallet-plugin-web-authenticator": "workspace:*",
        "@wuchale/svelte": "0.19.1",
