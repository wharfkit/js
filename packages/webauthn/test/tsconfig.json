{
    "extends": [
        "../tsconfig.json",
        "../../../tsconfig.test.json"
    ],
    "compilerOptions": {
        "baseUrl": "..",
        "paths": {
            "$lib": [
                "src"
            ],
            "$test": [
                "test"
            ],
            "$test/*": [
                "test/*"
            ]
        }
    },
    "include": [
        "*.ts",
        "**/*.ts",
        "../src/**/*.ts"
    ]
}
