{
    "name": "wallet-plugin-tacklebox",
    "description": "A TackleBox wallet plugin for use with @wharfkit/session.",
    "version": "0.2.0",
    "homepage": "https://github.com/on-a-t-break/wallet-plugin-tacklebox",
    "license": "BSD-3-Clause",
    "main": "lib/wallet-plugin-tacklebox.js",
    "module": "lib/wallet-plugin-tacklebox.m.js",
    "types": "lib/wallet-plugin-tacklebox.d.ts",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/on-a-t-break/wallet-plugin-tacklebox.git"
    },
    "files": [
        "lib/*",
        "src/*"
    ],
    "scripts": {
        "prepare": "npm run build",
        "build": "rollup -c",
        "lint": "eslint src --ext .ts --max-warnings 0",
        "format": "eslint src test --ext .ts --fix",
        "test": "mocha",
        "coverage": "nyc --temp-dir build/nyc_output --report-dir build/coverage --reporter=text mocha"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@greymass/buoy": "^1.0.3",
        "@wharfkit/antelope": "^1.0.5",
        "@wharfkit/protocol-esr": "^1.6.1",
        "isomorphic-ws": "^5.0.0",
        "tslib": "^2.1.0",
        "ws": "^8.13.0"
    },
    "peerDependencies": {
        "@wharfkit/session": "^1.7.0"
    },
    "devDependencies": {
        "@rollup/plugin-json": "^4.1.0",
        "@rollup/plugin-typescript": "^10.0.1",
        "@types/chai": "^4.3.1",
        "@types/mocha": "^9.0.0",
        "@types/node": "^18.7.18",
        "@typescript-eslint/eslint-plugin": "^5.20.0",
        "@typescript-eslint/parser": "^5.20.0",
        "@wharfkit/mock-data": "^1.3.0",
        "@wharfkit/session": "^1.7.0",
        "chai": "^4.3.4",
        "eslint": "^8.13.0",
        "eslint-config-prettier": "^8.1.0",
        "eslint-plugin-prettier": "^4.0.0",
        "mocha": "^10.0.0",
        "nyc": "^15.1.0",
        "pako": "^2.1.0",
        "prettier": "^2.2.1",
        "rollup": "^2.70.2",
        "rollup-plugin-dts": "^4.2.1",
        "sinon": "^15.0.1",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.1.1",
        "typescript": "^4.9.5"
    }
}
